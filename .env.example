# ==============================================================================
# Codebase Graph Intelligence Platform — Environment Configuration Example
# ==============================================================================

# Application Runtime Configuration
APP_NAME="Codebase Graph Intelligence Platform"
# Options: development | test | production
ENVIRONMENT="development"
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"
# Options: text | json (Use 'json' in production for structured logging)
LOG_FORMAT="text"
CORS_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=120
SECURITY_MAX_REQUEST_SIZE_BYTES=10485760

# Timeout Boundaries (seconds)
NEO4J_TIMEOUT_SECONDS=10.0
QDRANT_TIMEOUT_SECONDS=10.0
REDIS_TIMEOUT_SECONDS=5.0
LLM_TIMEOUT_SECONDS=30.0

# Neo4j Knowledge Graph Database Configuration
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"
NEO4J_DATABASE="neo4j"

# Qdrant Vector Database Configuration
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="codebase_chunks"

# Redis Queue & ARQ Worker Configuration
# Note: In production (ENVIRONMENT="production"), Redis is required for job queuing.
REDIS_URL="redis://localhost:6379"
JOB_TTL_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=86400
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT=300
WORKER_MAX_TRIES=3
WORKER_HEALTH_CHECK_INTERVAL=60

# Embedding Model Configuration (Hugging Face sentence-transformers)
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# LLM Provider Selection (openai)
LLM_PROVIDER="openai"

# OpenAI Provider Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-luna"

# PR & Webhook Integration Secrets
# Set these secrets in production to authenticate incoming GitHub/GitLab webhooks
GITHUB_WEBHOOK_SECRET=""
GITLAB_WEBHOOK_SECRET=""
GITHUB_TOKEN=""
GITLAB_TOKEN=""
